+"""Analytics payload (camelCase JSON on the wire, per prompt.md section 15)."""
+
+# ruff: noqa: N815 - wire format is camelCase per spec
+
+from __future__ import annotations
+
+from pydantic import BaseModel
+
+
+class TeamCounts(BaseModel):
+    inter: int = 0
+    gremio: int = 0
+
+
+class PullTotals(BaseModel):
+    overall: int = 0
+    inter: int = 0
+    gremio: int = 0
+
+
+class TimelinePoint(BaseModel):
+    t: int
+    inter: int
+    gremio: int
+
+
+class Peak(BaseModel):
+    value: int
+    t: int
+
+
+class PlayerStats(BaseModel):
+    playerId: str
+    name: str
+    team: str
+    pulls: int
+    pctOfTeam: float
+    pctOfAll: float
+    pullsPerSec: float
+
+
+class TeamStats(BaseModel):
+    players: int
+    totalPulls: int
+    avgPullsPerPlayer: float
+    bestPlayer: PlayerStats | None
+    worstPlayer: PlayerStats | None
+
+
+class TeamsStats(BaseModel):
+    inter: TeamStats
+    gremio: TeamStats
+
+
+class AnalyticsPayload(BaseModel):
+    result: str | None
+    endReason: str | None
+    durationS: int
+    totalPlayers: int
+    playersPerTeam: TeamCounts
+    totalPulls: PullTotals
+    pullsPerSecond: list[TimelinePoint]
+    peak: Peak
+    finalRope: float
+    teams: TeamsStats
+    players: list[PlayerStats]
+    leaderboard: list[PlayerStats]
diff --git a/backend/app/services/analytics.py b/backend/app/services/analytics.py
new file mode 100644
index 0000000..07b0cab
--- /dev/null
+++ b/backend/app/services/analytics.py
@@ -0,0 +1,108 @@
+"""Pure analytics over a finished match (no IO). See prompt.md section 15."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+from app.domain.entities import Match, Player, PullEvent
+from app.domain.enums import EndReason, Team
+from app.schemas.analytics import (
+    AnalyticsPayload,
+    Peak,
+    PlayerStats,
+    PullTotals,
+    TeamCounts,
+    TeamsStats,
+    TeamStats,
+    TimelinePoint,
+)
+
+LEADERBOARD_SIZE = 5
+
+
+def _pct(part: float, whole: float) -> float:
+    return round(100.0 * part / whole, 2) if whole else 0.0
+
+
+def compute_analytics(
+    match: Match,
+    players: Sequence[Player],
+    events: Sequence[PullEvent],
+    top_n: int = LEADERBOARD_SIZE,
+) -> AnalyticsPayload:
+    per_player: dict[str, int] = {p.id: 0 for p in players}
+    team_totals = {Team.INTER: 0, Team.GREMIO: 0}
+    buckets: dict[int, dict[Team, int]] = {}
+    for ev in events:
+        per_player[ev.player_id] = per_player.get(ev.player_id, 0) + ev.count
+        team_totals[ev.team] += ev.count
+        if match.started_at is not None:
+            sec = max(0, int((ev.server_ts - match.started_at).total_seconds()))
+            b = buckets.setdefault(sec, {Team.INTER: 0, Team.GREMIO: 0})
+            b[ev.team] += ev.count
+    total = sum(team_totals.values())
+
+    # Duration actually played: full length on timeout, else up to the last pull.
+    cfg = match.config.duration_s
+    if match.end_reason == EndReason.TIMEOUT:
+        duration = cfg
+    else:
+        duration = min(cfg, max(buckets, default=-1) + 1)
+
+    size = max(duration, max(buckets, default=-1) + 1)
+    timeline = [
+        TimelinePoint(
+            t=t,
+            inter=buckets.get(t, {}).get(Team.INTER, 0),
+            gremio=buckets.get(t, {}).get(Team.GREMIO, 0),
+        )
+        for t in range(size)
+    ]
+    # Ties resolve to the earliest second.
+    top = max(timeline, key=lambda p: (p.inter + p.gremio, -p.t), default=None)
+    peak = Peak(value=top.inter + top.gremio, t=top.t) if top else Peak(value=0, t=0)
+
+    def stats(p: Player) -> PlayerStats:
+        n = per_player[p.id]
+        return PlayerStats(
+            playerId=p.id,
+            name=p.name,
+            team=p.team.value,
+            pulls=n,
+            pctOfTeam=_pct(n, team_totals[p.team]),
+            pctOfAll=_pct(n, total),
+            pullsPerSec=round(n / duration, 2) if duration else 0.0,
+        )
+
+    # Deterministic order: most pulls first, then name, then id.
+    all_stats = sorted((stats(p) for p in players), key=lambda s: (-s.pulls, s.name, s.playerId))
+
+    def team_stats(team: Team) -> TeamStats:
+        mine = [s for s in all_stats if s.team == team.value]
+        return TeamStats(
+            players=len(mine),
+            totalPulls=team_totals[team],
+            avgPullsPerPlayer=round(team_totals[team] / len(mine), 2) if mine else 0.0,
+            bestPlayer=mine[0] if mine else None,
+            worstPlayer=(min(mine, key=lambda s: (s.pulls, s.name, s.playerId)) if mine else None),
+        )
+
+    return AnalyticsPayload(
+        result=match.result.value if match.result else None,
+        endReason=match.end_reason.value if match.end_reason else None,
+        durationS=duration,
+        totalPlayers=len(players),
+        playersPerTeam=TeamCounts(
+            inter=sum(p.team == Team.INTER for p in players),
+            gremio=sum(p.team == Team.GREMIO for p in players),
+        ),
+        totalPulls=PullTotals(
+            overall=total, inter=team_totals[Team.INTER], gremio=team_totals[Team.GREMIO]
+        ),
+        pullsPerSecond=timeline,
+        peak=peak,
+        finalRope=match.rope_position,
+        teams=TeamsStats(inter=team_stats(Team.INTER), gremio=team_stats(Team.GREMIO)),
+        players=all_stats,
+        leaderboard=all_stats[:top_n],
+    )
diff --git a/backend/tests/services/test_analytics.py b/backend/tests/services/test_analytics.py
new file mode 100644
index 0000000..8e6916f
--- /dev/null
+++ b/backend/tests/services/test_analytics.py
@@ -0,0 +1,95 @@
+from datetime import UTC, datetime, timedelta
+
+from app.domain.entities import Match, MatchConfig, Player, PullEvent, TeamConfig
+from app.domain.enums import BalanceMode, EndReason, MatchResult, MatchStatus, Team
+from app.services.analytics import compute_analytics
+
+T0 = datetime(2026, 1, 1, tzinfo=UTC)
+INT, G = Team.INTER, Team.GREMIO
+
+
+def _match(reason=EndReason.TIMEOUT, result=MatchResult.INTER, rope=-30.0, dur=10):
+    tc = TeamConfig(id="x", name="X", primary_color="#000", secondary_color="#fff")
+    return Match(
+        id="M",
+        status=MatchStatus.FINISHED,
+        config=MatchConfig(
+            duration_s=dur,
+            rope_target=100,
+            balance_mode=BalanceMode.NORMALIZED,
+            inter=tc,
+            gremio=tc,
+        ),
+        rope_position=rope,
+        started_at=T0,
+        result=result,
+        end_reason=reason,
+    )
+
+
+def _p(pid, team, name=None):
+    return Player(id=pid, match_id="M", device_id=pid, name=name or pid, team=team, token="t")
+
+
+def _e(pid, team, count, sec):
+    return PullEvent(
+        id=f"e{pid}{sec}{count}",
+        match_id="M",
+        player_id=pid,
+        team=team,
+        count=count,
+        client_ts=0,
+        server_ts=T0 + timedelta(seconds=sec),
+        batch_id=f"b{pid}{sec}{count}",
+    )
+
+
+def test_bucketing_and_peak():
+    players = [_p("a", INT), _p("b", G)]
+    events = [
+        _e("a", INT, 3, 0.2),
+        _e("a", INT, 2, 0.9),
+        _e("b", G, 4, 1.5),
+        _e("a", INT, 5, 3.0),
+        _e("b", G, 5, 3.9),
+    ]
+    a = compute_analytics(_match(), players, events)
+    first4 = [(p.t, p.inter, p.gremio) for p in a.pullsPerSecond[:4]]
+    assert first4 == [(0, 5, 0), (1, 0, 4), (2, 0, 0), (3, 5, 5)]
+    assert len(a.pullsPerSecond) == 10  # full duration on timeout
+    assert a.peak.model_dump() == {"value": 10, "t": 3}
+    assert a.totalPulls.model_dump() == {"overall": 19, "inter": 10, "gremio": 9}
+    assert a.finalRope == -30.0 and a.result == "inter" and a.endReason == "timeout"
+
+
+def test_best_worst_and_percentages():
+    players = [_p("a", INT), _p("b", INT), _p("c", INT), _p("d", G)]
+    events = [_e("a", INT, 6, 0), _e("b", INT, 2, 1), _e("d", G, 12, 1)]
+    a = compute_analytics(_match(), players, events)
+    t = a.teams.inter
+    assert (t.bestPlayer.playerId, t.worstPlayer.playerId) == ("a", "c")
+    assert t.avgPullsPerPlayer == round(8 / 3, 2) and t.players == 3
+    pa = next(p for p in a.players if p.playerId == "a")
+    assert pa.pctOfTeam == 75.0 and pa.pctOfAll == 30.0 and pa.pullsPerSec == 0.6
+    assert a.teams.gremio.bestPlayer.playerId == a.teams.gremio.worstPlayer.playerId == "d"
+    assert [p.playerId for p in a.leaderboard] == ["d", "a", "b", "c"]
+
+
+def test_empty_events_and_empty_team():
+    a = compute_analytics(_match(result=MatchResult.DRAW, rope=0), [_p("a", INT)], [])
+    assert a.totalPulls.overall == 0 and a.peak.value == 0
+    assert a.teams.gremio.bestPlayer is None and a.teams.gremio.avgPullsPerPlayer == 0.0
+    assert a.players[0].pctOfTeam == 0.0 and a.players[0].pctOfAll == 0.0
+    b = compute_analytics(_match(reason=EndReason.WIN), [], [])
+    assert b.durationS == 0 and b.pullsPerSecond == [] and b.leaderboard == []
+
+
+def test_win_duration_and_ties_deterministic():
+    players = [_p("z", INT, "Zed"), _p("y", INT, "Amy"), _p("g", G)]
+    events = [_e("z", INT, 5, 0), _e("y", INT, 5, 2.5)]
+    a = compute_analytics(_match(reason=EndReason.WIN), players, events)
+    assert a.durationS == 3
+    assert a.teams.inter.bestPlayer.name == "Amy"  # tie -> name order
+    b = compute_analytics(_match(reason=EndReason.WIN), list(reversed(players)), events)
+    assert [p.playerId for p in b.players] == [p.playerId for p in a.players]
+    assert len(compute_analytics(_match(), players, events, top_n=1).leaderboard) == 1
