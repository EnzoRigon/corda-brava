diff --git a/backend/Dockerfile b/backend/Dockerfile
new file mode 100644
index 0000000..81803a8
--- /dev/null
+++ b/backend/Dockerfile
@@ -0,0 +1,21 @@
+FROM python:3.11-slim AS build
+WORKDIR /src
+COPY pyproject.toml ./
+COPY app ./app
+RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir .
+
+FROM python:3.11-slim
+ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 \
+    DATABASE_URL=sqlite:////data/corda_brava.db
+RUN useradd --system --uid 10001 app && mkdir /data /app && chown app /data
+COPY --from=build /opt/venv /opt/venv
+COPY app /app/app
+WORKDIR /app
+USER app
+VOLUME /data
+EXPOSE 8000
+HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
+  CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health', timeout=2)"
+# Single worker on purpose: queue, registry and dedup are in-process. The backend is only
+# reachable via nginx, so trusting X-Forwarded-For from any peer is safe (login rate limit per client IP).
+CMD ["uvicorn", "app.core.app_factory:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
diff --git a/docker-compose.dev.yml b/docker-compose.dev.yml
new file mode 100644
index 0000000..4078a45
--- /dev/null
+++ b/docker-compose.dev.yml
@@ -0,0 +1,21 @@
+# Use: docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
+services:
+  backend:
+    command: uvicorn app.core.app_factory:create_app --factory --host 0.0.0.0 --port 8000 --reload --proxy-headers --forwarded-allow-ips=*
+    volumes:
+      - ./backend/app:/app/app
+    ports:
+      - "8000:8000"
+
+  frontend:
+    build:
+      context: ./frontend
+      target: dev
+    command: npm run dev -- --host 0.0.0.0
+    environment:
+      VITE_PROXY_TARGET: http://backend:8000
+    volumes:
+      - ./frontend:/app
+      - /app/node_modules
+    ports: !override
+      - "5173:5173"
diff --git a/docker-compose.yml b/docker-compose.yml
new file mode 100644
index 0000000..0e806a5
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,26 @@
+services:
+  backend:
+    build: ./backend
+    env_file: .env
+    environment:
+      HOST_PASSWORD: ${HOST_PASSWORD:?set HOST_PASSWORD in .env}
+      SECRET_KEY: ${SECRET_KEY:?set SECRET_KEY in .env}
+      DATABASE_URL: sqlite:////data/corda_brava.db
+    volumes:
+      - corda_data:/data
+    restart: unless-stopped
+
+  frontend:
+    build:
+      context: ./frontend
+      args:
+        VITE_PUBLIC_BASE: ${VITE_PUBLIC_BASE:-}
+    ports:
+      - "${PUBLIC_PORT:-80}:80"
+    depends_on:
+      backend:
+        condition: service_healthy
+    restart: unless-stopped
+
+volumes:
+  corda_data:
