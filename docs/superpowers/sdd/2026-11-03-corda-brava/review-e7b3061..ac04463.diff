diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..ba3c766
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,51 @@
+# Copy to .env and edit. Never commit .env.
+
+# --- Required (compose refuses to start without them) ---
+HOST_PASSWORD=change-me
+# Generate: python -c "import secrets; print(secrets.token_hex(32))"
+SECRET_KEY=
+
+# --- Network / QR ---
+# Public host port of the single entry point (nginx).
+PUBLIC_PORT=80
+# Origin phones open from the QR code. For LAN play use http://<LAN-IP> (not localhost);
+# on a VPS use its public hostname/IP. Add :PORT if PUBLIC_PORT is not 80.
+PUBLIC_BASE_URL=http://localhost
+# Frontend build-time fallback for the join URL (same value as above).
+VITE_PUBLIC_BASE=http://localhost
+# Optional: leave empty for same-origin (recommended behind nginx).
+# VITE_API_BASE=
+# VITE_WS_BASE=
+# Dev override only: where the Vite dev server proxies /api (set by docker-compose.dev.yml).
+# VITE_PROXY_TARGET=http://localhost:8000
+CORS_ORIGINS=*
+
+# --- Auth ---
+HOST_TOKEN_TTL_SECONDS=21600
+
+# --- Database (compose sets sqlite:////data/corda_brava.db on a named volume) ---
+# DATABASE_URL=sqlite:///./corda_brava.db
+
+# --- Game timing ---
+TICK_INTERVAL_MS=500
+DEFAULT_MATCH_DURATION_S=120
+MATCH_DURATION_MIN_S=30
+MATCH_DURATION_MAX_S=600
+
+# --- Rope ---
+ROPE_TARGET=100
+PULL_UNIT=1.0
+MAX_PULLS_PER_BATCH=200
+
+# --- Idempotency ---
+BATCH_DEDUP_TTL_S=30
+
+# --- Policies ---
+LATE_JOIN_POLICY=block
+TEAM_BALANCE_MODE=normalized
+
+# --- Queue ---
+QUEUE_BACKEND=memory
+QUEUE_LEASE_TIMEOUT_S=10
+# AZURE_SERVICEBUS_CONNECTION_STRING=
+# AZURE_SERVICEBUS_QUEUE_NAME=
