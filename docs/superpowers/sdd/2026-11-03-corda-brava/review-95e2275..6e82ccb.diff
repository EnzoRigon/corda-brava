+import { createElement, act } from "react";
+import { createRoot } from "react-dom/client";
+import { afterEach, expect, it, vi } from "vitest";
+import { useCountdown } from "./useCountdown";
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+afterEach(() => vi.useRealTimers());
+
+function C({ s }: { s: number }) {
+  return createElement("span", null, useCountdown(s).toFixed(1));
+}
+
+it("counts down between ticks and clamps at 0", async () => {
+  vi.useFakeTimers();
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  await act(async () => root.render(createElement(C, { s: 10 })));
+  expect(host.textContent).toBe("10.0");
+  await act(async () => void vi.advanceTimersByTime(2000));
+  expect(host.textContent).toBe("8.0");
+  await act(async () => void vi.advanceTimersByTime(20000));
+  expect(host.textContent).toBe("0.0");
+});
diff --git a/frontend/src/hooks/useCountdown.ts b/frontend/src/hooks/useCountdown.ts
new file mode 100644
index 0000000..abef3b5
--- /dev/null
+++ b/frontend/src/hooks/useCountdown.ts
@@ -0,0 +1,14 @@
+import { useEffect, useState } from "react";
+
+/** Visual countdown: counts down from the latest server `remainingS` between ticks; clamped at 0. */
+export function useCountdown(remainingS: number, running = true): number {
+  const [now, setNow] = useState(0);
+  const [base, setBase] = useState({ remainingS, at: Date.now() });
+  if (base.remainingS !== remainingS) setBase({ remainingS, at: Date.now() });
+  useEffect(() => {
+    if (!running) return;
+    const i = setInterval(() => setNow(Date.now()), 100);
+    return () => clearInterval(i);
+  }, [running]);
+  return running && now > base.at ? Math.max(0, base.remainingS - (now - base.at) / 1000) : Math.max(0, remainingS);
+}
