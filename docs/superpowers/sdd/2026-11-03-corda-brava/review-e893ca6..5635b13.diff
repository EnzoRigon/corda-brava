diff --git a/frontend/src/hooks/useHostSocket.test.ts b/frontend/src/hooks/useHostSocket.test.ts
new file mode 100644
index 0000000..1b17b49
--- /dev/null
+++ b/frontend/src/hooks/useHostSocket.test.ts
@@ -0,0 +1,101 @@
+import { createElement, act } from "react";
+import { createRoot } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { useHostSocket } from "./useHostSocket";
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+class MockWS {
+  static all: MockWS[] = [];
+  onopen: (() => void) | null = null;
+  onmessage: ((e: { data: string }) => void) | null = null;
+  onclose: ((e: { code: number }) => void) | null = null;
+  onerror: (() => void) | null = null;
+  closed = false;
+  constructor(public url: string) {
+    MockWS.all.push(this);
+  }
+  close() {
+    this.closed = true;
+  }
+  send(msg: unknown) {
+    void msg;
+  }
+}
+const cfg = { durationS: 60, ropeTarget: 100, balanceMode: "normalized", teams: {} };
+const match = {
+  id: "m1", status: "LOBBY", config: cfg, roster: { inter: [], gremio: [] },
+  rope: 0, remainingS: 60, scores: { inter: { pulls: 0 }, gremio: { pulls: 0 } }, result: null, endReason: null,
+};
+const last = () => MockWS.all[MockWS.all.length - 1];
+const msg = (m: unknown) => act(() => last().onmessage!({ data: JSON.stringify(m) }));
+const close = (code = 1006) => act(() => last().onclose!({ code }));
+
+let out: ReturnType<typeof useHostSocket>;
+let unmount: () => void;
+function Probe() {
+  out = useHostSocket("m1", "tok");
+  return null;
+}
+beforeEach(() => {
+  vi.useFakeTimers();
+  MockWS.all = [];
+  (globalThis as unknown as { WebSocket: unknown }).WebSocket = MockWS;
+  const root = createRoot(document.createElement("div"));
+  act(() => root.render(createElement(Probe)));
+  unmount = () => act(() => root.unmount());
+  act(() => last().onopen!());
+});
+afterEach(() => {
+  unmount();
+  vi.useRealTimers();
+});
+
+describe("useHostSocket", () => {
+  it("connects with token and exposes the snapshot", () => {
+    expect(last().url).toContain("/api/host/matches/m1/ws?token=tok");
+    expect(out.connected).toBe(true);
+    msg({ type: "snapshot", match });
+    expect(out.snapshot?.id).toBe("m1");
+    expect(out.status).toBe("LOBBY");
+  });
+  it("dedupes player_joined by id", () => {
+    msg({ type: "snapshot", match });
+    const p = { type: "player_joined", team: "inter", player: { id: "p1", name: "A" } };
+    msg(p);
+    msg(p);
+    expect(out.snapshot?.roster.inter).toHaveLength(1);
+  });
+  it("tick updates rope and scores", () => {
+    msg({ type: "snapshot", match });
+    msg({ type: "tick", rope: -5, remainingS: 50, delta: { inter: 1, gremio: 0 }, scores: { inter: { pulls: 3 }, gremio: { pulls: 1 } } });
+    expect(out.snapshot?.rope).toBe(-5);
+    expect(out.snapshot?.scores.inter.pulls).toBe(3);
+    expect(out.lastTick?.remainingS).toBe(50);
+  });
+  it("reconnects with backoff on unexpected close", () => {
+    close();
+    expect(out.connected).toBe(false);
+    expect(MockWS.all).toHaveLength(1);
+    act(() => void vi.advanceTimersByTime(1000));
+    expect(MockWS.all).toHaveLength(2);
+  });
+  it("1008 reports auth error and does not reconnect", () => {
+    close(1008);
+    act(() => void vi.advanceTimersByTime(10000));
+    expect(out.authError).toBe(true);
+    expect(MockWS.all).toHaveLength(1);
+  });
+  it.each([
+    [{ type: "ended", result: "DRAW", endReason: "timeout", finalRope: 0, analytics: { totalPlayers: 0 } }],
+    [{ type: "cancelled" }],
+    [{ type: "reset", newMatchId: "m2" }],
+  ])("%j is terminal: no reconnect", (m) => {
+    msg(m);
+    close();
+    act(() => void vi.advanceTimersByTime(10000));
+    expect(MockWS.all).toHaveLength(1);
+    if (m.type === "ended") expect(out.ended?.result).toBe("DRAW");
+    else expect(out.terminal?.type).toBe(m.type);
+  });
+});
diff --git a/frontend/src/hooks/useHostSocket.ts b/frontend/src/hooks/useHostSocket.ts
new file mode 100644
index 0000000..3dc619e
--- /dev/null
+++ b/frontend/src/hooks/useHostSocket.ts
@@ -0,0 +1,91 @@
+import { useEffect, useState } from "react";
+import { hostWsUrl } from "../api/hostApi";
+import type { CancelledMsg, EndedMsg, HostWsMsg, MatchView, ResetMsg, TickMsg } from "../types/api";
+
+export interface HostSocketState {
+  status: MatchView["status"] | null;
+  snapshot: MatchView | null;
+  lastTick: TickMsg | null;
+  ended: EndedMsg | null;
+  /** cancelled / reset (with newMatchId): the server closes right after. */
+  terminal: CancelledMsg | ResetMsg | null;
+  connected: boolean;
+  /** Server closed with 1008 (bad/expired token): the page should go to login. */
+  authError: boolean;
+}
+
+const INITIAL: HostSocketState = {
+  status: null, snapshot: null, lastTick: null, ended: null, terminal: null, connected: false, authError: false,
+};
+const MAX_BACKOFF_MS = 5000;
+
+function apply(s: HostSocketState, m: HostWsMsg): HostSocketState {
+  const snap = s.snapshot;
+  switch (m.type) {
+    case "snapshot":
+      return { ...s, snapshot: m.match, status: m.match.status };
+    case "player_joined": {
+      if (!snap || snap.roster[m.team].some((p) => p.id === m.player.id)) return s;
+      const roster = { ...snap.roster, [m.team]: [...snap.roster[m.team], m.player] };
+      return { ...s, snapshot: { ...snap, roster } };
+    }
+    case "tick":
+      return {
+        ...s,
+        lastTick: m,
+        status: "RUNNING",
+        snapshot: snap && { ...snap, status: "RUNNING", rope: m.rope, remainingS: m.remainingS, scores: m.scores },
+      };
+    case "ended":
+      return {
+        ...s,
+        ended: m,
+        status: "FINISHED",
+        snapshot: snap && { ...snap, status: "FINISHED", rope: m.finalRope, result: m.result, endReason: m.endReason },
+      };
+    default:
+      return { ...s, terminal: m };
+  }
+}
+
+export function useHostSocket(matchId: string, token: string): HostSocketState {
+  const [state, setState] = useState<HostSocketState>(INITIAL);
+
+  useEffect(() => {
+    let ws: WebSocket | null = null;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let attempt = 0;
+    let stopped = false; // unmounted, or ended/cancelled/reset/auth failure: never reconnect
+
+    const connect = () => {
+      ws = new WebSocket(hostWsUrl(matchId, token));
+      ws.onopen = () => {
+        attempt = 0;
+        setState((s) => ({ ...s, connected: true }));
+      };
+      ws.onmessage = (e) => {
+        const m = JSON.parse(e.data as string) as HostWsMsg;
+        if (m.type === "ended" || m.type === "cancelled" || m.type === "reset") stopped = true;
+        setState((s) => apply(s, m));
+      };
+      ws.onclose = (e) => {
+        setState((s) => ({ ...s, connected: false, authError: s.authError || e.code === 1008 }));
+        if (e.code === 1008) stopped = true;
+        if (stopped) return;
+        timer = setTimeout(connect, Math.min(500 * 2 ** attempt++, MAX_BACKOFF_MS));
+      };
+    };
+    connect();
+
+    return () => {
+      stopped = true;
+      clearTimeout(timer);
+      if (ws) {
+        ws.onclose = null;
+        ws.close();
+      }
+    };
+  }, [matchId, token]);
+
+  return state;
+}
