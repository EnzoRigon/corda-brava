@@ -0,0 +1,30 @@
+import { Navigate, Route, Routes, useParams } from "react-router-dom";
+
+// Placeholder pages; Tasks 12-16 replace each with the real screen.
+function Placeholder({ title, hasId = false }: { title: string; hasId?: boolean }) {
+  const { id } = useParams();
+  return (
+    <main style={{ padding: "var(--sp-lg)" }}>
+      <h1>{title}</h1>
+      {hasId && <p>Partida: {id}</p>}
+    </main>
+  );
+}
+
+export default function App() {
+  return (
+    <Routes>
+      <Route path="/" element={<Navigate to="/host/login" replace />} />
+      <Route path="/host/login" element={<Placeholder title="Entrar como host" />} />
+      <Route path="/host/create" element={<Placeholder title="Nova partida" />} />
+      <Route path="/host/lobby/:id" element={<Placeholder title="Sala de espera" hasId />} />
+      <Route path="/host/match/:id" element={<Placeholder title="Partida em andamento" hasId />} />
+      <Route path="/host/results/:id" element={<Placeholder title="Resultados" hasId />} />
+      <Route path="/j/:id" element={<Placeholder title="Entrar na partida" hasId />} />
+      <Route path="/j/:id/wait" element={<Placeholder title="Aguardando o host iniciar" hasId />} />
+      <Route path="/j/:id/play" element={<Placeholder title="PUXAR!" hasId />} />
+      <Route path="/j/:id/end" element={<Placeholder title="Obrigado por jogar!" hasId />} />
+      <Route path="*" element={<Navigate to="/" replace />} />
+    </Routes>
+  );
+}
diff --git a/frontend/src/api/client.ts b/frontend/src/api/client.ts
new file mode 100644
index 0000000..5991e2f
--- /dev/null
+++ b/frontend/src/api/client.ts
@@ -0,0 +1,47 @@
+// Empty defaults = same-origin relative paths (single-port Docker/nginx serving; Vite dev proxies /api).
+export const API_BASE: string = import.meta.env.VITE_API_BASE ?? "";
+export const WS_BASE: string = import.meta.env.VITE_WS_BASE ?? "";
+/** Origin for join/QR links; set to the LAN IP / public host so phones can reach it. */
+export const PUBLIC_BASE: string =
+  import.meta.env.VITE_PUBLIC_BASE || globalThis.location?.origin || "";
+
+export class ApiError extends Error {
+  status: number;
+  constructor(status: number, detail: string) {
+    super(detail);
+    this.name = "ApiError";
+    this.status = status;
+  }
+}
+
+export async function request<T>(
+  path: string,
+  opts: { method?: string; body?: unknown; token?: string; query?: Record<string, string> } = {},
+): Promise<T> {
+  const qs = opts.query ? "?" + new URLSearchParams(opts.query).toString() : "";
+  const headers: Record<string, string> = {};
+  if (opts.body !== undefined) headers["Content-Type"] = "application/json";
+  if (opts.token) headers["Authorization"] = `Bearer ${opts.token}`;
+  const res = await fetch(`${API_BASE}${path}${qs}`, {
+    method: opts.method ?? (opts.body !== undefined ? "POST" : "GET"),
+    headers,
+    body: opts.body !== undefined ? JSON.stringify(opts.body) : undefined,
+  });
+  if (!res.ok) {
+    let detail = "Erro inesperado. Tente novamente.";
+    try {
+      const j = await res.json();
+      if (typeof j?.detail === "string") detail = j.detail;
+    } catch {
+      // non-JSON error body: keep the generic message
+    }
+    throw new ApiError(res.status, detail);
+  }
+  return (await res.json()) as T;
+}
+
+/** Builds a ws(s):// URL; uses VITE_WS_BASE if set, else derives from the page origin. */
+export function wsUrl(path: string, query?: Record<string, string>): string {
+  const base = WS_BASE || globalThis.location.origin.replace(/^http/, "ws");
+  return `${base}${path}${query ? "?" + new URLSearchParams(query).toString() : ""}`;
+}
diff --git a/frontend/src/api/hostApi.ts b/frontend/src/api/hostApi.ts
