+import { createElement, act } from "react";
+import { createRoot } from "react-dom/client";
+import { MemoryRouter, Route, Routes, useLocation } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ApiError } from "../api/client";
+import * as api from "../api/playerApi";
+import { useMePolling } from "./useMePolling";
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const getMe = vi.spyOn(api, "getMe");
+let loc: string;
+let unmount: () => void;
+
+function Waiting() {
+  useMePolling("m1", "wait");
+  loc = useLocation().pathname;
+  return null;
+}
+function Other() {
+  loc = useLocation().pathname;
+  return null;
+}
+const tick = (ms = 1000) => act(async () => { await vi.advanceTimersByTimeAsync(ms); });
+
+beforeEach(async () => {
+  vi.useFakeTimers();
+  localStorage.setItem("cb.session.m1", JSON.stringify({ playerId: "p", playerToken: "t", team: "inter" }));
+  getMe.mockReset().mockResolvedValue({ screen: "wait", team: "inter", matchStatus: "LOBBY" });
+  const root = createRoot(document.createElement("div"));
+  await act(async () =>
+    root.render(
+      createElement(
+        MemoryRouter,
+        { initialEntries: ["/j/m1/wait"] },
+        createElement(
+          Routes,
+          null,
+          createElement(Route, { path: "/j/:id/wait", element: createElement(Waiting) }),
+          createElement(Route, { path: "*", element: createElement(Other) }),
+        ),
+      ),
+    ),
+  );
+  unmount = () => act(() => root.unmount());
+});
+afterEach(() => {
+  unmount();
+  vi.useRealTimers();
+});
+
+describe("useMePolling", () => {
+  it("polls with the stored token and navigates when the screen changes", async () => {
+    expect(getMe).toHaveBeenCalledWith("m1", "p", "t");
+    expect(loc).toBe("/j/m1/wait");
+    getMe.mockResolvedValue({ screen: "play", team: "inter", matchStatus: "RUNNING" });
+    await tick();
+    expect(loc).toBe("/j/m1/play");
+  });
+
+  it("returns to join and clears the session on 401", async () => {
+    getMe.mockRejectedValue(new ApiError(401, "x"));
+    await tick();
+    expect(loc).toBe("/j/m1");
+    expect(localStorage.getItem("cb.session.m1")).toBeNull();
+  });
+
+  it("stops polling on unmount", async () => {
+    unmount();
+    const n = getMe.mock.calls.length;
+    await tick(3000);
+    expect(getMe.mock.calls.length).toBe(n);
+    unmount = () => {};
+  });
+});
diff --git a/frontend/src/hooks/useMePolling.ts b/frontend/src/hooks/useMePolling.ts
new file mode 100644
index 0000000..b1c854c
--- /dev/null
+++ b/frontend/src/hooks/useMePolling.ts
@@ -0,0 +1,68 @@
+import { useEffect, useState } from "react";
+import { useNavigate } from "react-router-dom";
+import { ApiError } from "../api/client";
+import { getMe } from "../api/playerApi";
+import type { JoinResponse, MeResponse } from "../types/api";
+
+export const ME_POLL_MS = 1000;
+export type Screen = MeResponse["screen"];
+const key = (matchId: string) => `cb.session.${matchId}`;
+
+export function loadSession(matchId: string): JoinResponse | null {
+  try {
+    const s = JSON.parse(localStorage.getItem(key(matchId)) ?? "null");
+    return s?.playerId && s?.playerToken && s?.team ? s : null;
+  } catch {
+    return null;
+  }
+}
+export function saveSession(matchId: string, s: JoinResponse) {
+  try {
+    localStorage.setItem(key(matchId), JSON.stringify(s));
+  } catch {
+    // storage blocked: the player simply cannot resume after a reload
+  }
+}
+function clearSession(matchId: string) {
+  try {
+    localStorage.removeItem(key(matchId));
+  } catch {
+    // ignore
+  }
+}
+
+/** Polls /me with the stored token; navigates when the server's screen differs from `page`. */
+export function useMePolling(matchId: string, page: Screen) {
+  const navigate = useNavigate();
+  const [session] = useState(() => loadSession(matchId));
+  const [me, setMe] = useState<MeResponse | null>(null);
+
+  useEffect(() => {
+    if (!session) {
+      navigate(`/j/${matchId}`, { replace: true });
+      return;
+    }
+    let alive = true;
+    const poll = async () => {
+      try {
+        const r = await getMe(matchId, session.playerId, session.playerToken);
+        if (!alive) return;
+        setMe(r);
+        if (r.screen !== page) navigate(`/j/${matchId}/${r.screen}`, { replace: true });
+      } catch (e) {
+        if (alive && e instanceof ApiError && (e.status === 401 || e.status === 403)) {
+          clearSession(matchId);
+          navigate(`/j/${matchId}`, { replace: true });
+        } // other errors: keep polling
+      }
+    };
+    void poll();
+    const id = setInterval(() => void poll(), ME_POLL_MS);
+    return () => {
+      alive = false;
+      clearInterval(id);
+    };
+  }, [matchId, page, session, navigate]);
+
+  return { session, me };
+}
