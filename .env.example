# Copy to .env and edit. Never commit .env.
# This repo-root .env is read by Docker Compose. A local uvicorn reads backend/.env instead (never this file).

# --- Required (compose refuses to start without them) ---
HOST_PASSWORD=change-me
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Network / QR ---
# Public host port of the single entry point (nginx).
PUBLIC_PORT=80
# Origin phones open from the QR code. For LAN play use http://<LAN-IP> (not localhost);
# on a VPS use its public hostname/IP. Add :PORT if PUBLIC_PORT is not 80.
PUBLIC_BASE_URL=http://localhost
# Frontend build-time fallback for the join URL (same value as above).
VITE_PUBLIC_BASE=http://localhost
# Optional: leave empty for same-origin (recommended behind nginx).
# VITE_API_BASE=
# VITE_WS_BASE=
# Dev override only: where the Vite dev server proxies /api (set by docker-compose.dev.yml).
# VITE_PROXY_TARGET=http://localhost:8000
CORS_ORIGINS=*

# --- Auth ---
HOST_TOKEN_TTL_SECONDS=21600

# --- Database (compose sets sqlite:////data/corda_brava.db on a named volume) ---
# DATABASE_URL=sqlite:///./corda_brava.db

# --- Game timing ---
TICK_INTERVAL_MS=500
DEFAULT_MATCH_DURATION_S=120
MATCH_DURATION_MIN_S=30
MATCH_DURATION_MAX_S=600

# --- Rope ---
ROPE_TARGET=100
PULL_UNIT=1.0
MAX_PULLS_PER_BATCH=200
# Anti-cheat: max pulls one player can land per second (excess within a tick is dropped).
# 50/s = 25 per 500 ms tick. Owner's choice: high enough that fast multi-finger tappers never
# lose pulls (the client flushes on an unsynchronised 500 ms clock, so two flushes can share a tick).
MAX_PULLS_PER_PLAYER_PER_S=50

# --- Idempotency ---
BATCH_DEDUP_TTL_S=30

# --- Policies ---
LATE_JOIN_POLICY=block
TEAM_BALANCE_MODE=normalized

# --- Queue ---
# memory (default) or azure_service_bus
QUEUE_BACKEND=memory
# Lease of a received message, for both backends: the in-memory timeout and the Service Bus queue's LockDuration
# (5-300 s). After changing it with Service Bus, re-run: cd backend && python -m app.queue.provision
QUEUE_LEASE_TIMEOUT_S=10
# Read only when QUEUE_BACKEND=azure_service_bus. Namespace-level connection string, no EntityPath
# (portal > namespace > Shared access policies > RootManageSharedAccessKey > Primary connection string).
# Create (or check and fix) the queue with: cd backend && python -m app.queue.provision
# AZURE_SERVICEBUS_CONNECTION_STRING="Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<key>"
# AZURE_SERVICEBUS_QUEUE_NAME=corda-brava-pulls
